# Django
DJANGO_SECRET_KEY=replace-with-your-own-secret-key

# Supabase PostgreSQL
# Pilihan: session atau direct
DB_CONNECTION_MODE=session

SUPABASE_SESSION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase Edge Function
SUPABASE_EDGE_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/receive-sensor-data
